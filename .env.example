# Copy to .env and fill in real values. Never commit .env.

AIRFLOW_UID=50000
AIRFLOW_IMAGE_NAME=apache/airflow:3.4.0
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# MySQL staging database (host.docker.internal = server running on the host;
# use mysql-staging with: docker compose --profile local-db up -d)
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_DATABASE=flight_staging
MYSQL_USER=
MYSQL_PASSWORD=

# PostgreSQL analytics database (use analytics-db with the local-db profile)
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_DATABASE=flight_analytics
POSTGRES_USER=
POSTGRES_PASSWORD=

# Optional: Gmail address + app password for failure alerts.
# Leave GMAIL_ADDRESS empty to disable e-mail alerts.
GMAIL_ADDRESS=
GMAIL_PASSWORD=
